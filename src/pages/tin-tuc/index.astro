---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import posts from '../../data/posts.json';
import { useT, href, asset } from '../../i18n/ui.js';
const lang = 'vi';
const t = useT(lang);
const list = [...posts].sort((a, b) => new Date(b.date) - new Date(a.date));
---
<Base lang={lang} active="news" path="/tin-tuc" title={t('news.title')}>
  <div class="wrap"><nav class="crumbs"><a href={href(lang, '/')}>{t('nav.home')}</a><span>/</span>{t('news.title')}</nav></div>
  <section>
    <div class="wrap">
      <div class="sec-head"><div><span class="pill">Blog</span><h2>{t('news.title')}</h2></div></div>
      <div class="news-grid">
        {list.map((p) => (
          <a class="ncard" href={href(lang, `/tin-tuc/${p.slug}`)}>
            <div class="nimg">{p.image ? <img src={asset(p.image)} alt={p.title} loading="lazy" /> : <div class="ph"><Icon name="image" size={40} /></div>}</div>
            <div class="nbody">
              <time>{new Date(p.date).toLocaleDateString('vi-VN')}</time>
              <h3>{p.title}</h3>
              <p>{p.excerpt}</p>
              <span class="more">{t('news.readmore')} →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <style>
    .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
    .ncard{border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;background:#fff;transition:.18s;display:flex;flex-direction:column}
    .ncard:hover{box-shadow:var(--shadow-h);transform:translateY(-4px)}
    .nimg{aspect-ratio:16/10;background:var(--soft)}
    .nimg img{width:100%;height:100%;object-fit:cover}
    .nimg .ph{width:100%;height:100%;display:grid;place-items:center;font-size:40px;color:var(--line)}
    .nbody{padding:16px;display:flex;flex-direction:column;gap:8px;flex:1}
    .nbody time{font-size:12px;color:var(--slate)}
    .nbody h3{font-size:16px;line-height:1.35}
    .nbody p{font-size:13.5px;color:var(--slate);margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
    .more{margin-top:auto;color:var(--blue);font-weight:600;font-size:13.5px}
    @media(max-width:900px){.news-grid{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.news-grid{grid-template-columns:1fr}}
  </style>
</Base>
