---
import Base from '../layouts/Base.astro';
import ArticleContent from '../components/ArticleContent.astro';
import pages from '../data/pages.json';
import { infoPages } from '../data/site.js';
const lang = 'vi';
const meta = infoPages['cau-hoi-thuong-gap'];
const page = pages.find((p) => p.slug === 'cau-hoi-thuong-gap');
---
<Base lang={lang} active="faq" path="/cau-hoi-thuong-gap" title={meta.vi}>
  <ArticleContent lang={lang} title={meta.vi} text={page?.text || ''} />
</Base>
