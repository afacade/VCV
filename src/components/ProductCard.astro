---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
import { useT, href, asset, money } from '../i18n/ui.js';
import categories from '../data/categories.json';
const { lang = 'vi', product } = Astro.props;
const t = useT(lang);
const cat = categories.find((c) => c.slug === product.category);
const catLabel = cat ? (lang === 'en' ? cat.en : cat.vi) : '';
const name = lang === 'en' ? product.name_en : product.name_vi;
const url = href(lang, `/san-pham/${product.slug}`);
const quoteHref = `mailto:${site.email}?subject=${encodeURIComponent(t('quote.subject') + ': ' + product.name_vi)}`;
const sale = product.price ?? product.price_min;
const regular = product.price_regular && product.price_regular > sale ? product.price_regular : null;
const pct = regular ? Math.round((1 - sale / regular) * 100) : 0;
---
<article class="pcard">
  <div class="ph">
    {pct > 0 && <span class="sale-badge">-{pct}%</span>}
    <button class="fav" data-fav-id={product.slug} aria-label="Yêu thích" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.3 2 4.9 5.3 4.3 7.3 4 9.1 4.9 10 6.4l.9 1.4L12 8l1.1-.2.9-1.4c.9-1.5 2.7-2.4 4.7-2.1 3.3.6 4.9 4 3.3 7.4C19.5 16.4 12 21 12 21z"/></svg>
    </button>
    <a class="ph-link" href={url} aria-label={name}>
      {product.image ? <img src={asset(product.image)} alt={name} loading="lazy" /> : <div class="noimg"><Icon name="image" size={40} /></div>}
    </a>
  </div>
  <div class="body">
    {catLabel && <a class="ct" href={href(lang, `/danh-muc/${product.category}`)}>{catLabel}</a>}
    <h3><a href={url}>{name}</a></h3>
    <div class="price">
      <b>{money(sale)}</b>
      {regular && <s>{money(regular)}</s>}
    </div>
    <div class="actions">
      <a class="btn btn-blue" href={url}>{t('cta.details')}</a>
      <a class="btn btn-ghost" href={quoteHref}>{t('cta.quote')}</a>
    </div>
  </div>
</article>

<style>
  .noimg{width:100%;height:100%;display:grid;place-items:center;font-size:40px;color:var(--line)}
  .pcard .ph{position:relative}
  .pcard .ph .ph-link{position:absolute;inset:0;display:grid;place-items:center;padding:14px}
  .pcard .ph .ph-link img{width:auto;height:auto;max-width:100%;max-height:100%;object-fit:contain}
  .fav{position:absolute;top:8px;right:8px;z-index:3;width:34px;height:34px;border-radius:50%;border:1px solid var(--line);
    background:#fff;display:grid;place-items:center;cursor:pointer;color:#c2c8d4;transition:.15s;box-shadow:0 2px 8px rgba(19,44,112,.08)}
  .fav:hover{color:var(--red);border-color:var(--red)}
  .fav svg{fill:currentColor}
  .fav.on{color:var(--red);border-color:var(--red);background:#fff0f0}
  .pcard .ph .sale-badge{position:absolute;top:8px;left:8px;z-index:3;background:var(--red);color:#fff;font-weight:800;font-size:12px;padding:4px 9px;border-radius:8px}
  .pcard .body .ct{font-size:11px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;color:var(--blue);display:inline-block}
  .pcard .body .ct:hover{text-decoration:underline}
  .pcard .price{margin-top:auto;display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
  .pcard .price s{color:#aab0bd;font-size:13px;font-weight:500}
</style>
