---
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import categories from '../data/categories.json';
import allProducts from '../data/products.json';
import { site } from '../data/site.js';
import { useT, href, asset } from '../i18n/ui.js';

const { lang = 'vi' } = Astro.props;
const t = useT(lang);
const catName = (c) => (lang === 'en' ? c.en : c.vi);
const L = (vi, en) => (lang === 'en' ? en : vi);

const bestsellers = [...allProducts].sort((a, b) => (b.featured === true) - (a.featured === true)).slice(0, 10);
const blockCats = [...categories].sort((a, b) => b.count - a.count).slice(0, 3);
const productsFor = (slug, n) => allProducts.filter((p) => p.categories.includes(slug)).slice(0, n);
const usps = [
  { i: 'factory', t: t('usp.factory'), d: t('usp.factory.d') },
  { i: 'truck', t: t('usp.ship'), d: t('usp.ship.d') },
  { i: 'refresh', t: t('usp.return'), d: t('usp.return.d') },
  { i: 'chat', t: t('usp.support'), d: t('usp.support.d') },
];
const warehouse = L(site.address_warehouse_vi, site.address_warehouse_en).replace(/^.*?:\s*/, '');
const factory = L(site.address_factory_vi, site.address_factory_en).replace(/^.*?:\s*/, '');
---
<!-- ============ HERO: category sidebar + company info card ============ -->
<section class="hero-a">
  <div class="wrap hero-a-grid">
    <aside class="cat-side">
      <div class="cs-head"><Icon name="menu" size={16} /> {t('cta.categories')}</div>
      <ul>
        {categories.map((c) => (
          <li><a href={href(lang, `/danh-muc/${c.slug}`)}>
            {c.icon ? <img class="cicon" src={asset(c.icon)} alt="" loading="lazy" /> : <span class="dot" style={`background:${c.color}`}></span>}
            <span>{catName(c)}</span>
          </a></li>
        ))}
      </ul>
    </aside>
    <a class="hero-banner" href={href(lang, '/san-pham')}>
      <img src={asset('img/banner2.png')} alt={`${site.brand} — cung cấp các loại bìa`} />
    </a>
  </div>
</section>

<!-- ============ USP ============ -->
<div class="usp-strip">
  <div class="wrap usp-in">
    {usps.map((u) => (
      <div class="usp"><span class="ic"><Icon name={u.i} size={21} /></span><div><b>{u.t}</b><small>{u.d}</small></div></div>
    ))}
  </div>
</div>

<!-- ============ FEATURED — best sellers (10), made to pop ============ -->
<section class="feat">
  <div class="wrap">
    <div class="feat-head">
      <h2><Icon name="fire" size={26} solid={true} class="fire" /> {t('label.bestsellers')}</h2>
      <p>{L('Được hàng nghìn văn phòng & doanh nghiệp tin dùng', 'Trusted by thousands of offices & businesses')}</p>
    </div>
    <div class="featgrid">
      {bestsellers.map((p) => <ProductCard lang={lang} product={p} />)}
    </div>
    <div class="center" style="margin-top:22px">
      <a class="btn btn-red btn-lg" href={href(lang, '/san-pham')}>{t('cta.viewall')} 80+ {t('label.products')} →</a>
    </div>
  </div>
</section>

<!-- ============ Category blocks ============ -->
{blockCats.map((c) => (
  <section class="catblock">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="pill" style={`color:${c.color};background:${c.color}1a`}>{t('label.category')}</span><h2>{catName(c)}</h2></div>
        <a class="btn btn-ghost" href={href(lang, `/danh-muc/${c.slug}`)}>{t('cta.viewmore')} →</a>
      </div>
      <div class="pgrid">
        {productsFor(c.slug, 4).map((p) => <ProductCard lang={lang} product={p} />)}
      </div>
    </div>
  </section>
))}

<!-- ============ Brands ============ -->
<section class="brands">
  <div class="wrap">
    <div class="sec-head center" style="justify-content:center"><div><h2>{t('brands.title')}</h2></div></div>
    <div class="brand-row">
      {site.brands.map((b) => <img src={asset(b.img)} alt={b.name} loading="lazy" />)}
    </div>
  </div>
</section>

<!-- ============ Quote / long-term contract CTA ============ -->
<section class="ctaband-sec">
  <div class="wrap">
    <div class="ctaband">
      <div><h2>{t('contract.title')}</h2><p>{t('contract.sub')}</p></div>
      <div class="cb-btns">
        <a class="btn btn-red btn-lg" href={`tel:${site.phone_tel}`}><Icon name="phone" size={18} /> {site.phone}</a>
        <a class="btn btn-white btn-lg" href={site.zalo} target="_blank" rel="noopener"><img class="zi" src={asset('img/zalo.svg')} alt="" /> {t('cta.zalo')}</a>
        <a class="btn btn-ghost btn-lg" href={`mailto:${site.email}?subject=${encodeURIComponent(t('contract.title'))}`}>{t('contract.cta')}</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero A */
  .hero-a{background:var(--soft);padding:16px 0 26px}
  .hero-a-grid{display:grid;grid-template-columns:260px 1fr;gap:20px;align-items:start}
  .hero-banner{display:block;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);line-height:0}
  .hero-banner img{width:100%;height:auto;display:block}
  .cat-side{background:#fff;border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;align-self:start}
  .cs-head{background:var(--blue-d);color:#fff;font-weight:700;font-size:14px;padding:13px 18px}
  .cat-side ul{list-style:none;margin:0;padding:0}
  .cat-side li a{display:flex;align-items:center;gap:10px;padding:8px 16px;font-size:13.5px;border-bottom:1px solid var(--line)}
  .cat-side li:last-child a{border-bottom:0}
  .cat-side li a:hover{background:var(--soft);color:var(--blue)}
  .cat-side .dot{width:11px;height:11px;border-radius:3px;flex:none}
  .cat-side .cicon{width:30px;height:30px;object-fit:contain;border-radius:6px;background:var(--soft);padding:3px;flex:none}

  .btn-white{background:#fff;color:var(--blue)}
  .btn-white:hover{background:#eef3ff}
  .zi{width:20px;height:20px;border-radius:4px;vertical-align:middle}

  /* USP */
  .usp-strip{border-bottom:1px solid var(--line);background:#fff}
  .usp-in{display:grid;grid-template-columns:repeat(4,1fr)}
  .usp{display:flex;gap:12px;align-items:center;padding:16px}
  .usp+.usp{border-left:1px solid var(--line)}
  .usp .ic{width:42px;height:42px;border-radius:11px;background:var(--blue-l);color:var(--blue);display:grid;place-items:center;font-size:19px;flex:none}
  .usp b{display:block;font-size:14px}
  .usp small{color:var(--slate);font-size:12.5px}

  /* Featured (pop) */
  .feat{background:linear-gradient(180deg,#fff,var(--soft));padding:36px 0 40px}
  .feat-head{text-align:center;margin-bottom:24px}
  .feat-head h2{font-size:30px;font-weight:800;letter-spacing:-.01em;display:inline-flex;align-items:center;gap:8px}
  .feat-head h2 :global(.fire){color:#ff6a1a}
  .feat-head p{color:var(--slate);margin:6px 0 0}
  .featgrid{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}

  /* Category blocks (tighter) */
  section{padding:36px 0}
  .catblock:nth-child(even){background:var(--soft)}
  .brands{background:var(--soft);padding:32px 0}
  .brand-row{display:flex;justify-content:space-around;align-items:center;gap:24px;flex-wrap:wrap}
  .brand-row img{height:38px;width:auto;filter:grayscale(1);opacity:.7;transition:.2s}
  .brand-row img:hover{filter:none;opacity:1}

  .ctaband-sec{padding:0 0 40px}
  .ctaband{background:linear-gradient(120deg,var(--blue),var(--blue-d));color:#fff;border-radius:18px;padding:32px 36px;display:flex;justify-content:space-between;align-items:center;gap:22px;flex-wrap:wrap}
  .ctaband h2{font-size:23px;margin-bottom:6px}
  .ctaband p{margin:0;color:#cdd8f2;max-width:520px}
  .cb-btns{display:flex;gap:10px;flex-wrap:wrap}
  .ctaband .btn-ghost{background:transparent;color:#fff;border-color:rgba(255,255,255,.5)}
  .ctaband .btn-ghost:hover{background:rgba(255,255,255,.12)}

  @media(max-width:1000px){ .featgrid{grid-template-columns:repeat(3,1fr)} }
  @media(max-width:920px){
    .hero-a-grid{grid-template-columns:1fr}
    .cat-side{display:none}
    .hero-b-in{grid-template-columns:1fr;gap:22px}
    .usp-in{grid-template-columns:1fr 1fr}
    .usp:nth-child(3){border-left:0}
  }
  @media(max-width:720px){ .featgrid{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:600px){
    .usp-in{grid-template-columns:1fr}
    .usp+.usp{border-left:0;border-top:1px solid var(--line)}
  }
</style>
