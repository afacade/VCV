---
import faqRaw from '../data/faq.json';
import { useT, href } from '../i18n/ui.js';
const { lang = 'vi' } = Astro.props;
const t = useT(lang);
// dedupe by question
const seen = new Set();
const faq = faqRaw.filter((f) => { const k = f.q.trim().toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; });
---
<div class="wrap">
  <nav class="crumbs"><a href={href(lang, '/')}>{t('nav.home')}</a><span>/</span>{t('nav.faq')}</nav>
</div>

<section class="faq">
  <div class="wrap">
    <header class="faq-head">
      <h1>{t('nav.faq')}</h1>
      <p class="muted">{lang === 'en' ? 'Common questions about our folders, orders, delivery and payment.' : 'Những câu hỏi thường gặp về sản phẩm, đặt hàng, giao hàng và thanh toán.'}</p>
    </header>

    <div class="faq-list">
      {faq.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span class="q">{f.q}</span>
            <span class="chev" aria-hidden="true">＋</span>
          </summary>
          <div class="a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>

    <div class="faq-cta">
      <p>{lang === 'en' ? "Didn't find your answer?" : 'Chưa tìm thấy câu trả lời?'}</p>
      <a class="btn btn-red btn-lg" href={href(lang, '/lien-he')}>{t('nav.contact')}</a>
    </div>
  </div>
</section>

<style>
  .faq{padding:20px 0 44px}
  .faq-head{margin-bottom:24px;padding-bottom:18px;border-bottom:2px solid var(--line)}
  .faq-head h1{font-size:30px}
  .faq-head p{margin:8px 0 0}
  .faq-list{max-width:880px;display:flex;flex-direction:column;gap:12px}
  details{border:1px solid var(--line);border-radius:var(--radius);background:#fff;overflow:hidden;transition:.15s}
  details[open]{border-color:var(--blue);box-shadow:var(--shadow)}
  summary{display:flex;align-items:center;gap:14px;padding:16px 20px;cursor:pointer;list-style:none;font-weight:600;font-size:15.5px}
  summary::-webkit-details-marker{display:none}
  summary:hover{color:var(--blue)}
  summary .q{flex:1}
  summary .chev{width:26px;height:26px;flex:none;border-radius:50%;background:var(--blue-l);color:var(--blue);display:grid;place-items:center;font-size:18px;line-height:1;transition:.2s}
  details[open] summary .chev{transform:rotate(45deg);background:var(--blue);color:#fff}
  .a{padding:0 20px 18px;color:var(--slate);line-height:1.7}
  .a p{margin:0}
  .faq-cta{margin-top:32px;padding:26px;background:var(--soft);border:1px solid var(--line);border-radius:var(--radius);text-align:center}
  .faq-cta p{margin:0 0 14px;font-weight:600}
</style>
