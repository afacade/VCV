---
import { site, policyPages } from '../data/site.js';
import Icon from './Icon.astro';
import { useT, href, asset } from '../i18n/ui.js';
const { lang = 'vi' } = Astro.props;
const t = useT(lang);
const policyName = (p) => (lang === 'en' ? p.en : p.vi);
const links = [
  { label: t('nav.about'), url: href(lang, '/gioi-thieu') },
  { label: t('nav.products'), url: href(lang, '/san-pham') },
  { label: t('nav.news'), url: href(lang, '/tin-tuc') },
  { label: t('nav.faq'), url: href(lang, '/cau-hoi-thuong-gap') },
  { label: t('nav.contact'), url: href(lang, '/lien-he') },
];
---
<footer class="site-foot">
  <div class="wrap cols">
    <div class="col-brand">
      <img class="logo-f" src={asset('img/logo.png')} alt={site.brand} />
      <p class="addr"><Icon name="factory" size={15} /> {lang === 'en' ? site.address_factory_en : site.address_factory_vi}</p>
      <p class="addr"><Icon name="warehouse" size={15} /> {lang === 'en' ? site.address_warehouse_en : site.address_warehouse_vi}</p>
      <div class="badge"><Icon name="check-circle" size={15} /> {t('foot.notified')}</div>
    </div>
    <div>
      <h4>{t('foot.links')}</h4>
      {links.map((l) => <a href={l.url}>{l.label}</a>)}
    </div>
    <div>
      <h4>{t('foot.policies')}</h4>
      {Object.entries(policyPages).map(([slug, p]) => <a href={href(lang, `/${slug}`)}>{policyName(p)}</a>)}
    </div>
    <div class="col-contact">
      <h4>{t('foot.contact')}</h4>
      <p><b>{t('label.hotline')}:</b> <a href={`tel:${site.phone_tel}`}>{site.hotline}</a></p>
      <p><b>Zalo:</b> <a href={site.zalo}>{site.phone}</a></p>
      <p><b>Email:</b> <a href={`mailto:${site.email}`}>{site.email}</a></p>
      <a class="btn btn-red" href={`mailto:${site.email}?subject=${encodeURIComponent(t('quote.subject'))}`}>{t('cta.sendEmail')}</a>
      <div class="foot-soc">
        <a class="fs fs-fb" href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook Fanpage">
          <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.29-.04-1.3-.13-2.47-.13-2.45 0-4.13 1.5-4.13 4.24v2.19H7.4V13h2.7v8h3.4z"/></svg>
        </a>
        <a class="fs fs-zalo" href={site.zalo} target="_blank" rel="noopener" aria-label="Zalo"><img src={asset('img/zalo.svg')} alt="Zalo" /></a>
      </div>
    </div>
  </div>
  <div class="foot-bar">
    <div class="wrap fb-in">
      <span>© {new Date().getFullYear()} {lang === 'en' ? site.company_en : site.company_vi}</span>
      <span class="muted-f">{site.brand}</span>
    </div>
  </div>
</footer>

<style>
  .site-foot{background:#0F1626;color:#aeb7c7;padding:48px 0 0;font-size:14px;margin-top:20px}
  .cols{display:grid;grid-template-columns:1.6fr 1fr 1.2fr 1.1fr;gap:32px;padding-bottom:36px;border-bottom:1px solid rgba(255,255,255,.08)}
  .site-foot h4{color:#fff;font-size:15px;margin-bottom:14px}
  .site-foot a{display:block;padding:5px 0;color:#aeb7c7}
  .site-foot a:hover{color:#fff}
  .logo-f{height:44px;background:#fff;padding:8px 12px;border-radius:10px;margin-bottom:14px}
  .addr{line-height:1.6;margin:0 0 10px;color:#c3cad7}
  .badge{display:inline-block;margin-top:6px;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);
    color:#dfe4ee;font-size:12px;padding:6px 12px;border-radius:8px}
  .col-contact p{margin:0 0 8px;color:#c3cad7}
  .col-contact p a{display:inline;padding:0}
  .col-contact b{color:#dfe4ee}
  .col-contact .btn{margin-top:10px}
  .foot-soc{display:flex;gap:10px;margin-top:14px}
  .foot-soc .fs{width:34px;height:34px;border-radius:8px;display:grid;place-items:center;overflow:hidden}
  .foot-soc .fs-fb{background:#1877F2;color:#fff}
  .foot-soc .fs-zalo{background:#fff}
  .foot-soc .fs-zalo img{width:34px;height:34px}
  .foot-bar{padding:16px 0;font-size:13px;color:#7d8699}
  .fb-in{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}
  @media(max-width:820px){.cols{grid-template-columns:1fr 1fr}}
  @media(max-width:520px){.cols{grid-template-columns:1fr}}
</style>
