---
import { site } from '../data/site.js';
import categories from '../data/categories.json';
import Icon from './Icon.astro';
import { useT, href, asset } from '../i18n/ui.js';

const { lang = 'vi', active = '', path = '/' } = Astro.props;
const t = useT(lang);
const nav = [
  { key: 'home', label: t('nav.home'), url: href(lang, '/') },
  { key: 'products', label: t('nav.products'), url: href(lang, '/san-pham') },
  { key: 'about', label: t('nav.about'), url: href(lang, '/gioi-thieu') },
  { key: 'faq', label: t('nav.faq'), url: href(lang, '/cau-hoi-thuong-gap') },
  { key: 'news', label: t('nav.news'), url: href(lang, '/tin-tuc') },
  { key: 'contact', label: t('nav.contact'), url: href(lang, '/lien-he') },
];
const catName = (c) => (lang === 'en' ? c.en : c.vi);
---
<header class="site-head">
  <!-- Top utility bar -->
  <div class="util">
    <div class="wrap util-in">
      <div class="u-left">
        <span><Icon name="phone" size={13} /> {t('label.hotline')}: <a href={`tel:${site.phone_tel}`}>{site.hotline}</a></span>
        <a class="hide-sm" href={`mailto:${site.email}`}><Icon name="mail" size={13} /> {site.email}</a>
      </div>
      <div class="u-right">
        <a class="soc soc-fb" href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook Fanpage">
          <svg viewBox="0 0 24 24" width="15" height="15"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5H16.7V3.6c-.29-.04-1.3-.13-2.47-.13-2.45 0-4.13 1.5-4.13 4.24v2.19H7.4V13h2.7v8h3.4z"/></svg>
        </a>
        <a class="soc soc-zalo" href={site.zalo} target="_blank" rel="noopener" aria-label="Zalo">
          <img src={asset('img/zalo.svg')} alt="Zalo" />
        </a>
        <div class="langsw">
          <a class={lang === 'vi' ? 'on' : ''} href={href('vi', path)}>VI</a>
          <a class={lang === 'en' ? 'on' : ''} href={href('en', path)}>EN</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main header -->
  <div class="wrap head-main">
    <a class="logo" href={href(lang, '/')}><img src={asset('img/logo.png')} alt={site.brand} /></a>
    <nav class="primary">
      {nav.map((n) => <a class={active === n.key ? 'act' : ''} href={n.url}>{n.label}</a>)}
    </nav>
    <div class="head-right">
      <a class="phone" href={`tel:${site.phone_tel}`}>
        <span class="ic"><Icon name="phone" size={16} /></span>
        <span><b>{site.phone}</b><small>{t('cta.call')}</small></span>
      </a>
      <a class="fav-link" href={href(lang, '/yeu-thich')} aria-label={t('nav.fav')} title={t('nav.fav')}>
        <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 21s-7.5-4.6-10-9.3C.4 8.3 2 4.9 5.3 4.3 7.3 4 9.1 4.9 10 6.4l.9 1.4L12 8l1.1-.2.9-1.4c.9-1.5 2.7-2.4 4.7-2.1 3.3.6 4.9 4 3.3 7.4C19.5 16.4 12 21 12 21z"/></svg>
        <span class="fav-badge" data-fav-count hidden>0</span>
      </a>
      <a class="btn btn-red hide-sm" href={`mailto:${site.email}?subject=${encodeURIComponent(t('quote.subject'))}`}>{t('cta.quote')}</a>
      <button class="menu-btn" data-toggle="mobile-menu" aria-label="Menu"><Icon name="menu" size={24} /></button>
    </div>
  </div>

  <!-- Blue category bar -->
  <div class="catbar">
    <div class="wrap catbar-in">
      <div class="catmenu" data-dropdown="cat-panel">
        <button class="catmenu-btn" data-toggle="cat-panel">
          <Icon name="menu" size={18} /> {t('cta.categories')} <span class="chev">▾</span>
        </button>
        <div class="cat-panel" id="cat-panel" hidden>
          {categories.map((c) => (
            <a href={href(lang, `/danh-muc/${c.slug}`)}>
              {c.icon ? <img class="cicon" src={asset(c.icon)} alt="" loading="lazy" /> : <span class="dot" style={`background:${c.color}`}></span>}
              <span>{catName(c)}</span>
              <em>{c.count}</em>
            </a>
          ))}
        </div>
      </div>
      <form class="search" action={href(lang, '/san-pham')} method="get">
        <input type="text" name="q" placeholder={t('cta.search')} autocomplete="off" />
        <button type="submit" aria-label="Search"><Icon name="search" size={18} /></button>
      </form>
      <a class="catbar-cta" href={site.zalo} target="_blank" rel="noopener"><Icon name="chat" size={16} /> {t('cta.zalo')}</a>
    </div>
  </div>

  <!-- Mobile menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    {nav.map((n) => <a href={n.url}>{n.label}</a>)}
    <div class="mm-cats">
      <div class="mm-h">{t('cta.categories')}</div>
      {categories.map((c) => (
        <a href={href(lang, `/danh-muc/${c.slug}`)}>
          {c.icon && <img src={asset(c.icon)} alt="" loading="lazy" />}<span>{catName(c)}</span> <em>({c.count})</em>
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .site-head{position:sticky;top:0;z-index:50;background:#fff}
  /* util */
  .util{background:var(--blue-d);color:#cdd8f2;font-size:13px}
  .util-in{display:flex;justify-content:space-between;align-items:center;height:38px;gap:16px}
  .util a{color:#fff}
  .u-left{display:flex;gap:20px;align-items:center}
  .u-right{display:flex;gap:14px;align-items:center}
  .langsw{display:inline-flex;border:1px solid rgba(255,255,255,.28);border-radius:999px;overflow:hidden}
  .langsw a{padding:2px 11px;font-size:12px;font-weight:700;color:#dfe7fa}
  .langsw a.on{background:#fff;color:var(--blue-d)}
  .soc{display:inline-grid;place-items:center;width:26px;height:26px;border-radius:50%;color:#fff;overflow:hidden}
  .soc-fb{background:#1877F2}
  .soc-zalo{background:#fff}
  .soc-zalo img{width:26px;height:26px}
  /* main */
  .head-main{display:flex;align-items:center;gap:24px;height:78px}
  .logo img{height:44px;width:auto}
  .primary{display:flex;gap:22px;margin-left:6px}
  .primary a{font-weight:600;font-size:14.5px;padding:6px 0;position:relative;white-space:nowrap}
  .primary a:hover,.primary a.act{color:var(--blue)}
  .primary a.act::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:2px;background:var(--red)}
  .head-right{margin-left:auto;display:flex;align-items:center;gap:14px}
  .phone{display:flex;align-items:center;gap:9px}
  .phone .ic{width:36px;height:36px;border-radius:50%;background:var(--blue-l);color:var(--blue);display:grid;place-items:center;font-size:16px;flex:none}
  .phone b{display:block;color:var(--red);font-size:16px;line-height:1.1;white-space:nowrap}
  .phone small{color:var(--slate);font-size:11px}
  .fav-link{position:relative;color:var(--ink);display:grid;place-items:center;width:42px;height:42px;border-radius:50%;transition:.15s}
  .fav-link:hover{background:var(--soft);color:var(--red)}
  .fav-link svg{fill:none;stroke:currentColor;stroke-width:2}
  .fav-badge{position:absolute;top:1px;right:1px;min-width:18px;height:18px;padding:0 4px;border-radius:999px;background:var(--red);color:#fff;font-size:11px;font-weight:700;display:grid;place-items:center;line-height:1}
  .menu-btn{display:none;background:none;border:0;font-size:26px;color:var(--blue);cursor:pointer;line-height:1}
  /* category bar */
  .catbar{background:var(--blue);color:#fff}
  .catbar-in{display:flex;align-items:center;gap:14px;height:52px}
  .catmenu{position:relative}
  .catmenu-btn{display:flex;align-items:center;gap:10px;background:var(--blue-d);color:#fff;border:0;height:52px;padding:0 20px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer;min-width:250px}
  .catmenu-btn .chev{margin-left:auto}
  .cat-panel{position:absolute;top:52px;left:0;width:300px;background:#fff;color:var(--ink);border:1px solid var(--line);border-top:0;box-shadow:var(--shadow-h);z-index:20;max-height:70vh;overflow:auto}
  .cat-panel a{display:flex;align-items:center;gap:10px;padding:11px 18px;font-size:14px;border-bottom:1px solid var(--line)}
  .cat-panel a:last-child{border-bottom:0}
  .cat-panel a:hover{background:var(--soft);color:var(--blue)}
  .cat-panel .dot{width:12px;height:12px;border-radius:3px;flex:none}
  .cat-panel .cicon{width:34px;height:34px;object-fit:contain;border-radius:7px;background:var(--soft);padding:3px;flex:none}
  .cat-panel em{margin-left:auto;color:var(--slate);font-style:normal;font-size:12px}
  .search{flex:1;display:flex;background:#fff;border-radius:8px;overflow:hidden;max-width:640px}
  .search input{flex:1;border:0;padding:11px 14px;font-family:inherit;font-size:14px;outline:none}
  .search button{border:0;background:var(--red);color:#fff;padding:0 18px;cursor:pointer;font-size:15px}
  .catbar-cta{margin-left:auto;font-weight:700;font-size:14px;white-space:nowrap}
  /* mobile menu */
  .mobile-menu{display:none;flex-direction:column;background:#fff;border-top:1px solid var(--line);padding:8px 0}
  .mobile-menu>a{padding:12px 20px;font-weight:600;border-bottom:1px solid var(--line)}
  .mm-cats{padding:10px 20px}
  .mm-h{font-size:12px;font-weight:700;text-transform:uppercase;color:var(--slate);margin:6px 0}
  .mm-cats a{display:flex;align-items:center;gap:10px;padding:8px 0;font-size:14px}
  .mm-cats a img{width:28px;height:28px;object-fit:contain;border-radius:6px;background:var(--soft);padding:2px;flex:none}
  .mm-cats em{color:var(--slate);font-style:normal;margin-left:auto}

  @media(max-width:920px){
    .primary,.phone small{display:none}
    .menu-btn{display:block}
    .catbar-cta{display:none}
    .catmenu-btn{min-width:auto;padding:0 14px}
    .mobile-menu[hidden]{display:none}
    .mobile-menu{display:flex}
  }
  @media(max-width:560px){
    .hide-sm{display:none}
    .cat-panel{width:min(90vw,300px)}
  }
</style>
